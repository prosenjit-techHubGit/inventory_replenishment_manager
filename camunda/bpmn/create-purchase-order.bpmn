<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CreatePurchaseOrder" targetNamespace="http://example.com/procurement" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="create-purchase-order" name="Create Purchase Order" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Created" name="Create PO Requested">
      <bpmn:outgoing>Flow_ToRegisterProcessStart</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CreatePO" messageRef="Message_CreatePurchaseOrder" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_RegisterProcessStart" name="Register Process Start">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-process-start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRegisterProcessStart</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDuplicateCheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DuplicateProcessStart" name="Duplicate Process Start?" default="Flow_NotDuplicate">
      <bpmn:incoming>Flow_ToDuplicateCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Duplicate</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotDuplicate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_DuplicateStart" name="Duplicate Start Discarded">
      <bpmn:incoming>Flow_Duplicate</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_PreparePo" name="Prepare PO">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="prepare-po" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotDuplicate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSubmitForApproval</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_SubmitForApproval" name="Submit for Approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="submit-po-for-approval" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSubmitForApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDetermineApprovalRoute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="BusinessRuleTask_DetermineApprovalRoute" name="Determine Approval Route">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="determine-po-approvers" resultVariable="approvalRouting" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToDetermineApprovalRoute</bpmn:incoming>
      <bpmn:incoming>Flow_RevisionLoopBack</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProcurementApproval</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="UserTask_ProcurementApproval" name="Procurement Manager Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="PROCUREMENT_MANAGER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToProcurementApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ToProcurementOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ProcurementOutcome" name="Procurement Outcome" default="Flow_ProcurementApproved">
      <bpmn:incoming>Flow_ToProcurementOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcurementRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProcurementRevision</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProcurementApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_FinanceRequired" name="Finance Required?" default="Flow_FinanceNotRequired">
      <bpmn:incoming>Flow_ProcurementApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceRequired</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinanceNotRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_FinanceApproval" name="Finance Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="FINANCE_APPROVER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FinanceRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinanceOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinanceOutcome" name="Finance Outcome" default="Flow_FinanceApproved">
      <bpmn:incoming>Flow_ToFinanceOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_FinanceRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinanceRevision</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinanceApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_SupplyChainRequired" name="Supply Chain Required?" default="Flow_SupplyChainNotRequired">
      <bpmn:incoming>Flow_FinanceNotRequired</bpmn:incoming>
      <bpmn:incoming>Flow_FinanceApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_SupplyChainRequired</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupplyChainNotRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_SupplyChainApproval" name="Supply Chain Manager Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="SUPPLY_CHAIN_MANAGER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SupplyChainRequired</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSupplyChainOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SupplyChainOutcome" name="Supply Chain Outcome" default="Flow_SupplyChainApproved">
      <bpmn:incoming>Flow_ToSupplyChainOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_SupplyChainRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupplyChainRevision</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupplyChainApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_MarkApproved" name="Mark PO Approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-po-approved" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SupplyChainNotRequired</bpmn:incoming>
      <bpmn:incoming>Flow_SupplyChainApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSupplierConfirmation</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_RevisePO" name="Revise Purchase Order">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="PROCUREMENT_BUYER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProcurementRevision</bpmn:incoming>
      <bpmn:incoming>Flow_FinanceRevision</bpmn:incoming>
      <bpmn:incoming>Flow_SupplyChainRevision</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApplyRevision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_ApplyRevision" name="Apply Revision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-po-revision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToApplyRevision</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisionLoopBack</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_RejectPO" name="Reject PO">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-po" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProcurementRejected</bpmn:incoming>
      <bpmn:incoming>Flow_FinanceRejected</bpmn:incoming>
      <bpmn:incoming>Flow_SupplyChainRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Rejected" name="PO Rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_SupplierConfirmation" name="Supplier Confirmation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="SUPPLIER_USER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToSupplierConfirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSupplierOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_SupplierOutcome" name="Supplier Outcome" default="Flow_SupplierConfirmed">
      <bpmn:incoming>Flow_ToSupplierOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_SupplierRejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupplierRevisedDate</bpmn:outgoing>
      <bpmn:outgoing>Flow_SupplierConfirmed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_MarkSupplierRejected" name="Mark Supplier Rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="mark-supplier-rejected" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SupplierRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndSupplierRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_SupplierRejected" name="Supplier Rejected">
      <bpmn:incoming>Flow_ToEndSupplierRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_ReleasePO" name="Release to Supplier">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="release-purchase-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SupplierRevisedDate</bpmn:incoming>
      <bpmn:incoming>Flow_SupplierConfirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToTrackShipment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="UserTask_TrackShipment" name="Track Shipment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="WAREHOUSE_RECEIVER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToTrackShipment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGoodsReceipt</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="TimerBoundary_ShipmentOverdue" name="Shipment Overdue" cancelActivity="false" attachedToRef="UserTask_TrackShipment">
      <bpmn:outgoing>Flow_ToFlagDelayed</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ShipmentOverdue">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="ServiceTask_FlagShipmentDelayed" name="Flag Shipment Delayed">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flag-shipment-delayed" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToFlagDelayed</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndShipmentFlagged</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ShipmentFlagged" name="Shipment Flagged">
      <bpmn:incoming>Flow_ToEndShipmentFlagged</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_GoodsReceipt" name="Goods Receipt">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="WAREHOUSE_RECEIVER" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGoodsReceipt</bpmn:incoming>
      <bpmn:incoming>Flow_NotFullyReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUpdateInventory</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_UpdateInventory" name="Update Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToUpdateInventory</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFullyReceived</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FullyReceived" name="Fully Received?" default="Flow_NotFullyReceived">
      <bpmn:incoming>Flow_ToFullyReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_NotFullyReceived</bpmn:outgoing>
      <bpmn:outgoing>Flow_FullyReceived</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_CompletePO" name="Complete PO">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="complete-po" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FullyReceived</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndCompleted</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Completed" name="PO Completed">
      <bpmn:incoming>Flow_ToEndCompleted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToRegisterProcessStart" sourceRef="StartEvent_Created" targetRef="ServiceTask_RegisterProcessStart" />
    <bpmn:sequenceFlow id="Flow_ToDuplicateCheck" sourceRef="ServiceTask_RegisterProcessStart" targetRef="Gateway_DuplicateProcessStart" />
    <bpmn:sequenceFlow id="Flow_Duplicate" sourceRef="Gateway_DuplicateProcessStart" targetRef="EndEvent_DuplicateStart">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=duplicateProcessStart = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotDuplicate" sourceRef="Gateway_DuplicateProcessStart" targetRef="ServiceTask_PreparePo" />
    <bpmn:sequenceFlow id="Flow_ToSubmitForApproval" sourceRef="ServiceTask_PreparePo" targetRef="ServiceTask_SubmitForApproval" />
    <bpmn:sequenceFlow id="Flow_ToDetermineApprovalRoute" sourceRef="ServiceTask_SubmitForApproval" targetRef="BusinessRuleTask_DetermineApprovalRoute" />
    <bpmn:sequenceFlow id="Flow_ToProcurementApproval" sourceRef="BusinessRuleTask_DetermineApprovalRoute" targetRef="UserTask_ProcurementApproval" />
    <bpmn:sequenceFlow id="Flow_ToProcurementOutcome" sourceRef="UserTask_ProcurementApproval" targetRef="Gateway_ProcurementOutcome" />
    <bpmn:sequenceFlow id="Flow_ProcurementRejected" sourceRef="Gateway_ProcurementOutcome" targetRef="ServiceTask_RejectPO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalOutcome = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ProcurementRevision" sourceRef="Gateway_ProcurementOutcome" targetRef="UserTask_RevisePO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalOutcome = "RETURNED_FOR_REVISION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ProcurementApproved" sourceRef="Gateway_ProcurementOutcome" targetRef="Gateway_FinanceRequired" />
    <bpmn:sequenceFlow id="Flow_FinanceRequired" sourceRef="Gateway_FinanceRequired" targetRef="UserTask_FinanceApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalRouting.financeApprovalRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceNotRequired" sourceRef="Gateway_FinanceRequired" targetRef="Gateway_SupplyChainRequired" />
    <bpmn:sequenceFlow id="Flow_ToFinanceOutcome" sourceRef="UserTask_FinanceApproval" targetRef="Gateway_FinanceOutcome" />
    <bpmn:sequenceFlow id="Flow_FinanceRejected" sourceRef="Gateway_FinanceOutcome" targetRef="ServiceTask_RejectPO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalOutcome = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceRevision" sourceRef="Gateway_FinanceOutcome" targetRef="UserTask_RevisePO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalOutcome = "RETURNED_FOR_REVISION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinanceApproved" sourceRef="Gateway_FinanceOutcome" targetRef="Gateway_SupplyChainRequired" />
    <bpmn:sequenceFlow id="Flow_SupplyChainRequired" sourceRef="Gateway_SupplyChainRequired" targetRef="UserTask_SupplyChainApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalRouting.supplyChainApprovalRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupplyChainNotRequired" sourceRef="Gateway_SupplyChainRequired" targetRef="ServiceTask_MarkApproved" />
    <bpmn:sequenceFlow id="Flow_ToSupplyChainOutcome" sourceRef="UserTask_SupplyChainApproval" targetRef="Gateway_SupplyChainOutcome" />
    <bpmn:sequenceFlow id="Flow_SupplyChainRejected" sourceRef="Gateway_SupplyChainOutcome" targetRef="ServiceTask_RejectPO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalOutcome = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupplyChainRevision" sourceRef="Gateway_SupplyChainOutcome" targetRef="UserTask_RevisePO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalOutcome = "RETURNED_FOR_REVISION"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupplyChainApproved" sourceRef="Gateway_SupplyChainOutcome" targetRef="ServiceTask_MarkApproved" />
    <bpmn:sequenceFlow id="Flow_ToSupplierConfirmation" sourceRef="ServiceTask_MarkApproved" targetRef="UserTask_SupplierConfirmation" />
    <bpmn:sequenceFlow id="Flow_ToApplyRevision" sourceRef="UserTask_RevisePO" targetRef="ServiceTask_ApplyRevision" />
    <bpmn:sequenceFlow id="Flow_RevisionLoopBack" sourceRef="ServiceTask_ApplyRevision" targetRef="BusinessRuleTask_DetermineApprovalRoute" />
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="ServiceTask_RejectPO" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_ToSupplierOutcome" sourceRef="UserTask_SupplierConfirmation" targetRef="Gateway_SupplierOutcome" />
    <bpmn:sequenceFlow id="Flow_SupplierRejected" sourceRef="Gateway_SupplierOutcome" targetRef="ServiceTask_MarkSupplierRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confirmationStatus = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupplierRevisedDate" sourceRef="Gateway_SupplierOutcome" targetRef="ServiceTask_ReleasePO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=confirmationStatus = "REVISED_DATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SupplierConfirmed" sourceRef="Gateway_SupplierOutcome" targetRef="ServiceTask_ReleasePO" />
    <bpmn:sequenceFlow id="Flow_ToEndSupplierRejected" sourceRef="ServiceTask_MarkSupplierRejected" targetRef="EndEvent_SupplierRejected" />
    <bpmn:sequenceFlow id="Flow_ToTrackShipment" sourceRef="ServiceTask_ReleasePO" targetRef="UserTask_TrackShipment" />
    <bpmn:sequenceFlow id="Flow_ToFlagDelayed" sourceRef="TimerBoundary_ShipmentOverdue" targetRef="ServiceTask_FlagShipmentDelayed" />
    <bpmn:sequenceFlow id="Flow_ToEndShipmentFlagged" sourceRef="ServiceTask_FlagShipmentDelayed" targetRef="EndEvent_ShipmentFlagged" />
    <bpmn:sequenceFlow id="Flow_ToGoodsReceipt" sourceRef="UserTask_TrackShipment" targetRef="UserTask_GoodsReceipt" />
    <bpmn:sequenceFlow id="Flow_ToUpdateInventory" sourceRef="UserTask_GoodsReceipt" targetRef="ServiceTask_UpdateInventory" />
    <bpmn:sequenceFlow id="Flow_ToFullyReceived" sourceRef="ServiceTask_UpdateInventory" targetRef="Gateway_FullyReceived" />
    <bpmn:sequenceFlow id="Flow_NotFullyReceived" sourceRef="Gateway_FullyReceived" targetRef="UserTask_GoodsReceipt" />
    <bpmn:sequenceFlow id="Flow_FullyReceived" sourceRef="Gateway_FullyReceived" targetRef="ServiceTask_CompletePO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fullyReceived = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToEndCompleted" sourceRef="ServiceTask_CompletePO" targetRef="EndEvent_Completed" />
  </bpmn:process>
  <bpmn:message id="Message_CreatePurchaseOrder" name="CREATE_PURCHASE_ORDER" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_create-purchase-order">
    <bpmndi:BPMNPlane id="BPMNPlane_create-purchase-order" bpmnElement="create-purchase-order">
      <bpmndi:BPMNShape id="StartEvent_Created_di" bpmnElement="StartEvent_Created">
        <dc:Bounds x="112" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RegisterProcessStart_di" bpmnElement="ServiceTask_RegisterProcessStart">
        <dc:Bounds x="230" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DuplicateProcessStart_di" bpmnElement="Gateway_DuplicateProcessStart" isMarkerVisible="true">
        <dc:Bounds x="405" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_PreparePo_di" bpmnElement="ServiceTask_PreparePo">
        <dc:Bounds x="530" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_SubmitForApproval_di" bpmnElement="ServiceTask_SubmitForApproval">
        <dc:Bounds x="680" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BusinessRuleTask_DetermineApprovalRoute_di" bpmnElement="BusinessRuleTask_DetermineApprovalRoute">
        <dc:Bounds x="830" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ProcurementApproval_di" bpmnElement="UserTask_ProcurementApproval">
        <dc:Bounds x="980" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ProcurementOutcome_di" bpmnElement="Gateway_ProcurementOutcome" isMarkerVisible="true">
        <dc:Bounds x="1155" y="75" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_DuplicateStart_di" bpmnElement="EndEvent_DuplicateStart">
        <dc:Bounds x="412" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_RejectPO_di" bpmnElement="ServiceTask_RejectPO">
        <dc:Bounds x="700" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="850" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_RevisePO_di" bpmnElement="UserTask_RevisePO">
        <dc:Bounds x="830" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ApplyRevision_di" bpmnElement="ServiceTask_ApplyRevision">
